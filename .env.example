# ==========================================
# CAMPUS LUA AZUL - VARIABLES DE ENTORNO
# ==========================================

# URL base del sitio (en Vercel o local)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Mercado Pago (obtenido en https://www.mercadopago.com.ar/developers/panel)
# Para pruebas locales o producción:
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Resend (envío de emails automáticos desde https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Campus Lua Azul <campus@luaazul.com.ar>

# Secreto para firmar las cookies de sesión (generar con: openssl rand -hex 32)
# Cambiarlo invalida todas las sesiones activas.
AUTH_SECRET=

# Secreto para autenticar los Vercel Cron Jobs (generar con: openssl rand -hex 32)
# Debe coincidir con el que Vercel manda en el header Authorization al llamar /api/cron/*
CRON_SECRET=

# Supabase (base de datos). Proyecto: campus-lua-azul, en supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: nunca exponer al navegador. Se usa solo en rutas API del servidor.
SUPABASE_SERVICE_ROLE_KEY=
